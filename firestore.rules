rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A space is reachable only by whoever knows its long random id (the shared link).
    // Spaces themselves cannot be listed, so ids cannot be discovered.
    match /spaces/{space}/items/{item} {
      allow read: if space.size() >= 20;
      allow delete: if space.size() >= 20;
      allow create, update: if space.size() >= 20
        && request.resource.data.keys().hasOnly(['id', 'title', 'desc', 'cat', 'auto', 'createdAt', 'updatedAt', 'doneAt'])
        && request.resource.data.id == item
        && request.resource.data.title is string && request.resource.data.title.size() <= 2000
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 50000
        && request.resource.data.createdAt is int;
    }
  }
}
